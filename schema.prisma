  productAmount    Int?                  @default(0)
  commissionRate   Decimal?              @default("0") @postgresql.Decimal(18, 4)
  commissionAmount Int?                  @default(0)
  paidAt           DateTime?
  metadata         Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt

  @@index([shopId])
  @@index([barberId])
  @@index([transactionId])
  @@index([appointmentId])
  @@index([payoutId])
}

model Supplier {
  id                         String              @id @default(cuid())
  shop                       Shop                @relation("Supplier_shop", fields: [shopId], references: [id])
  shopId                     String              @map("shop")
  name                       String              @default("")
  status                     SupplierStatusType? @default(active)
  contactName                String              @default("")
  email                      String              @default("")
  phone                      String              @default("")
  website                    String              @default("")
  notes                      String              @default("")
  metadata                   Json?
  createdAt                  DateTime            @default(now())
  updatedAt                  DateTime            @default(now()) @updatedAt
  from_InventoryLot_supplier InventoryLot[]      @relation("InventoryLot_supplier")

  @@index([shopId])
}

model InventoryLot {
  id                String                  @id @default(cuid())
  shop              Shop                    @relation("InventoryLot_shop", fields: [shopId], references: [id])
  shopId            String                  @map("shop")
  lotNumber         String                  @default("")
  product           Product?                @relation("InventoryLot_product", fields: [productId], references: [id])
  productId         String?                 @map("product")
  supplier          Supplier?               @relation("InventoryLot_supplier", fields: [supplierId], references: [id])
  supplierId        String?                 @map("supplier")
  quantityReceived  Int?                    @default(0)
  quantityRemaining Int?                    @default(0)
  unitCost          Int?                    @default(0)
  receivedAt        DateTime?
  expiresAt         DateTime?
  status            InventoryLotStatusType? @default(active)
  metadata          Json?
  movements         InventoryMovement[]     @relation("InventoryMovement_inventoryLot")
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt

  @@unique([shopId, lotNumber], map: "InventoryLot_shop_lotNumber_key")
  @@index([shopId])
  @@index([lotNumber])
  @@index([productId])
  @@index([supplierId])
}

model Product {
  id                 String                  @id @default(cuid())
  shop               Shop                    @relation("Product_shop", fields: [shopId], references: [id])
  shopId             String                  @map("shop")
  name               String                  @default("")
  sku                String                  @default("")
  status             ProductStatusType?      @default(active)
  productType        ProductProductTypeType? @default(other)
  price              Int?                    @default(0)
  cost               Int?                    @default(0)
  description        String                  @default("")
  imagePath          String                  @default("")
  image_id           String?
  image_filesize     Int?
  image_width        Int?
  image_height       Int?
  image_extension    String?
  inventoryTracked   Boolean                 @default(true)
  metadata           Json?
  inventoryLots      InventoryLot[]          @relation("InventoryLot_product")
  inventoryMovements InventoryMovement[]     @relation("InventoryMovement_product")
  saleLines          ProductSaleLine[]       @relation("ProductSaleLine_product")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @default(now()) @updatedAt

  @@unique([shopId, sku], map: "Product_shop_sku_key")
  @@index([shopId])
  @@index([sku])
}

model BarberChair {
  id                 String                 @id @default(cuid())
  shop               Shop                   @relation("BarberChair_shop", fields: [shopId], references: [id])
  shopId             String                 @map("shop")
  chairNumber        String                 @default("")
  stationName        String                 @default("")
  status             BarberChairStatusType? @default(active)
  assignedBarbers    Barber[]               @relation("Barber_chair")
  scheduleExceptions ScheduleException[]    @relation("ScheduleException_chair")
  shifts             StaffShift[]           @relation("StaffShift_chair")
  appointments       Appointment[]          @relation("Appointment_chair")
  locationNote       String                 @default("")
  metadata           Json?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @default(now()) @updatedAt

  @@unique([shopId, chairNumber], map: "BarberChair_shop_chairNumber_key")
  @@index([shopId])
  @@index([chairNumber])
}

